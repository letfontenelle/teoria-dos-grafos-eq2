# Copie este arquivo para .env e preencha com as credenciais do projeto no Supabase
# (Project Settings > API). Nunca faça commit do .env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave de administrador: ignora o RLS. Use só no back-end, nunca no front.
SUPABASE_SERVICE_ROLE_KEY=
