# Copie este arquivo para .env (na raiz do repositório) e preencha.
# Nunca faça commit do .env.

# Banco usado pela API e pela carga: sqlite (padrão, arquivo local) ou supabase.
BANCO=sqlite
# Caminho opcional do arquivo SQLite (padrão: back-end/database/grade.db).
# BANCO_SQLITE=

# Credenciais do projeto no Supabase (Project Settings > API), usadas com BANCO=supabase.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave de administrador: ignora o RLS. Use só no back-end, nunca no front.
SUPABASE_SERVICE_ROLE_KEY=
